# Leave empty to use the built-in simulator (no backend needed).
# Set to the API origin (or leave "/" with the Vite dev proxy) to talk to the .NET backend.
VITE_API_URL=

# Optional: Google Maps basemap (Map Tiles API). Leave empty for the free CARTO basemap.
# Put the real key in frontend/.env.local (git-ignored) and restrict it to your site's referrers.
VITE_GOOGLE_MAPS_API_KEY=
